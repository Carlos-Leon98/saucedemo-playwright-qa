{
  "name": "saucedemo-playwright-qa",
  "version": "1.0.0",
  "description": "Playwright + TypeScript QA automation suite for saucedemo.com, built with the Page Object Model and CI on GitHub Actions.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com"
  },
  "keywords": ["playwright", "typescript", "qa", "automation", "page-object-model", "ci-cd"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6"
  }
}
